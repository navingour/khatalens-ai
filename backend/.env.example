# KhataLens AI — Backend Environment Configuration
# Target Region: asia-south1 (Mumbai, India)

# Cloud Run & Google Cloud Configuration
GCP_PROJECT_ID=khatalens-ai-prod
GCP_REGION=asia-south1
GCS_BUCKET_NAME=khatalens-bills-asia-south1

# Firebase Admin SDK Credentials
# Path to serviceAccountKey.json relative to backend/ or absolute path
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Google Gemini & Vertex AI Configuration
# Set GOOGLE_GENAI_USE_VERTEXAI=true to use Vertex AI with serviceAccountKey.json
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_LOCATION=us-central1
VERTEX_SERVICE_ACCOUNT_PATH=backend/vertexAccountKey.json
# Fallback Gemini Developer API Key if Vertex AI is disabled
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Real GSP / GSTIN Verification API (falls back gracefully to deterministic realistic engine if blank)
GSTIN_API_KEY=
GSTIN_API_BASE_URL=https://api.mastergst.com/v1/gstin/

# Cron Secret for Google Cloud Scheduler 6-hour sync
CRON_SECRET=khatalens-cron-secret-2026

# Environment Mode
ENVIRONMENT=development
PORT=8000
ALLOW_DEV_AUTH=True
